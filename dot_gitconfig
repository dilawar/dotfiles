[branch]
    sort = -committerdate
[tag]
    sort = version:refname
[init]
    defaultBranch = main
[user]
    name = Dilawar Singh
    email = "dilawar.s@toyotaconnected.co.in"
[core]
	pager = delta
    fsmonitor = true
    untrackedCache = true
	autocrlf = input
[merge]
    tool = nvimdiff
[diff]
  tool = nvimdiff
  external = difft
[alias]
    lol = log --all --decorate --oneline --graph
    lg1 = log --graph --abbrev-commit --decorate --all
    lg = !"git lg1"
    tree = log --graph --oneline --decorate --all
    #
    # Difftastic aliases, so `git dlog -p` is `git log -p`
    # with difftastic and likewise for the other subcommands.
    #
    dlog = -c diff.external=difft log --ext-diff
    dshow = -c diff.external=difft show --ext-diff
    ddiff = -c diff.external=difft diff
    #
    # `git log` with patches shown with difftastic.
    #
    dl = -c diff.external=difft log -p --ext-diff
    # Show the most recent commit with difftastic.
    ds = -c diff.external=difft show --ext-diff
    # `git diff` with difftastic.
    dft = -c diff.external=difft diff
[pull]
    rebase = true
[push]
    default = simple
    autoSetupRemote = true
    followTags = true
[fetch]
    prune = true
    pruneTags = true
    all = false

[credential "https://gitlab.dognosis.link"]
	helper = !glab auth git-credential

[help]
    autocorrect = prompt
[commit]
    verbose = true
	  gpgsign = false
[rerere]
	enabled = true
    autoupdate = true
[rebase]
    autoSquash = true
    autoStash = true
    updateRefs = true
[checkout]
	defaultRemote = origin
[grep]
    lineNumber = true
[credential "https://gitlab.com"]
	helper = !glab auth git-credential
[delta]
	navigate = true
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[merge "npm-translate-lock-merge"]
	name = Merge driver for the Bazel npm translate lock files
	driver = true
[mergetool]
	keepBackup = false
